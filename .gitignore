# Track source only; private runtime files are opt-in excluded by default.
/*
!/.gitignore
!/README.md
!/README.en.md
!/CHANGELOG.md
!/AGENTS.md
!/package.json
!/package-lock.json
!/install.sh
!/qr.sh

!/wechat-setup

!/USER-GUIDE.md

!/install.ps1
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

!/config-templates/
!/config-templates/*.example.json
!/config-templates/ssh-config.example
!/docs/
!/docs/images/
!/docs/images/*.png
!/CONFIGURATION.md
# Private deployment and runtime data, including nested directories.
**/*.local.json
**/*.local.md
**/.private/
**/remote-hosts.json
**/targets.json
**/remote-sessions.json

# Credentials and account runtime data must never enter source, even under allowed directories.
!/.gitattributes
**/.ssh/
**/.codex/
**/.config/
**/.local/
**/accounts/
!/src/infrastructure/accounts/
**/attachments/
**/outputs/
**/backups/
**/logs/
**/.env
**/.env.*
**/ha.json
**/backup.json
**/monitor.json
**/credentials.json
**/account.json
**/account-identity.json
**/codex-owners.json
**/codex-sessions.json
**/integrations.json
**/installation.json
**/notification-jobs.json
**/wechat_hosts_config
**/known_hosts
**/authorized_keys
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db
**/*.db-wal
**/*.db-shm

# Public license and project policies.
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/SECURITY.md

# Modular source and tests.
!/src/
!/tests/
**/__pycache__/
**/*.pyc

# Local CodeGraph configuration and generated indexes.
/codegraph.config.json
**/.codegraph/

# Local prerelease upgrade helper.
/upgrade-main.sh
