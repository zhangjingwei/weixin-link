# Track source only; private runtime files are opt-in excluded by default.
/*
!/.gitignore
!/*.mjs
!/*.py
!/*.sh
!/README.md
!/package.json
!/package-lock.json
!/codegraph.config.json
!/agent-workspace/
/agent-workspace/*
!/agent-workspace/AGENTS.md
!/agent-workspace/targets.example.json
!/agent-workspace/remote-*.mjs
!/agent-workspace/remote-hosts.example.json
!/agent-workspace/REMOTE-HOSTS.md
!/install.sh
!/wechat-ping-bot.service
!/wechat-ping-bot@.service

!/wechat-setup

!/USER-GUIDE.md

!/*.ps1
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

!/examples/
!/examples/*.example.json
!/examples/ssh-config.example
!/CONFIGURATION.md
# Private deployment and runtime data, including nested directories.
**/*.local.json
**/*.local.md
**/.private/
**/remote-hosts.json
**/targets.json
**/remote-sessions.json

# Credentials and account runtime data must never enter source, even under allowed directories.
!/.gitattributes
**/.ssh/
**/.codex/
**/.config/
**/.local/
**/accounts/
**/attachments/
**/outputs/
**/backups/
**/logs/
**/.env
**/.env.*
**/ha.json
**/backup.json
**/monitor.json
**/credentials.json
**/account.json
**/account-identity.json
**/codex-owners.json
**/codex-sessions.json
**/installation.json
**/notification-jobs.json
**/wechat_hosts_config
**/known_hosts
**/authorized_keys
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db
**/*.db-wal
**/*.db-shm

# Public license and project policies.
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/SECURITY.md

# Modular source and tests.
!/src/
!/tests/
**/__pycache__/
**/*.pyc
