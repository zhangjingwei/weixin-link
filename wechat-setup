#!/bin/sh
set -eu
setup_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
setup_node="${HOME}/.local/share/wechat-ping-bot/tools/node/bin/node"
if test -x "$setup_node"; then PATH="$(dirname "$setup_node"):$PATH"; export PATH; exec "$setup_node" "$setup_root/src/setup/setup.mjs" "$@"; fi
exec node "$setup_root/src/setup/setup.mjs" "$@"
