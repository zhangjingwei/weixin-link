# Defense in depth for git archive. The release checker rejects tracked secrets too.
.private export-ignore
**/.private export-ignore
.ssh export-ignore
**/.ssh export-ignore
accounts/** export-ignore
**/accounts/** export-ignore
src/infrastructure/accounts/account-store.mjs -export-ignore
src/infrastructure/accounts/codex-home.mjs -export-ignore
src/infrastructure/accounts/provider-profile.mjs -export-ignore
outputs export-ignore
**/outputs export-ignore
attachments export-ignore
**/attachments export-ignore
backups export-ignore
**/backups export-ignore
logs export-ignore
**/logs export-ignore
**/ha.json export-ignore
**/credentials.json export-ignore
**/account.json export-ignore
**/account-identity.json export-ignore
**/codex-owners.json export-ignore
**/installation.json export-ignore
**/remote-hosts.json export-ignore
**/targets.json export-ignore
**/remote-sessions.json export-ignore
**/*.pem export-ignore
**/*.key export-ignore
**/*.local.json export-ignore
**/*.local.md export-ignore
