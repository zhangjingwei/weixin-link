# Copy into your private SSH config and replace every placeholder.
Host remote-linux backup-host
    HostName host.example.com
    User example
    IdentityFile ~/.ssh/wechat_ed25519
    UserKnownHostsFile ~/.ssh/wechat_known_hosts
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    ConnectTimeout 8
