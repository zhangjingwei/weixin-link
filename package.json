{
  "name": "weixin-link",
  "version": "1.2.0",
  "description": "A self-hosted bridge for continuing Codex tasks from WeChat.",
  "main": "src/wechat/bot.mjs",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:media-live": "node src/tools/media-live-check.mjs",
    "check:codex-input": "node src/tools/verify-media-contract.mjs",
    "postinstall": "node src/tools/sdk-upload-timeout.mjs && node src/tools/sdk-protocol-patch.mjs",
    "setup": "node src/setup/setup.mjs",
    "doctor": "node src/setup/setup.mjs doctor",
    "check:release": "node src/tools/release-check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "@wechatbot/wechatbot": "2.2.0",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "silk-wasm": "3.7.1",
    "proper-lockfile": "4.1.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/darwin-arm64": "4.1.5",
    "@ffmpeg-installer/darwin-x64": "4.1.0",
    "@ffmpeg-installer/linux-arm64": "4.1.4",
    "@ffmpeg-installer/linux-x64": "4.1.0",
    "@ffmpeg-installer/win32-x64": "4.1.0"
  }
}
